<?xml version="1.0" encoding="UTF-8"?>
<!--
  Contenedor mínimo para Samsung Smart TV (Tizen).

  La aplicación en sí sigue viviendo en el servidor: este paquete solo abre esa
  URL a pantalla completa. Así la TV recibe siempre la última versión sin
  reinstalar nada, y se conservan el renderizado en servidor, el índice de
  logos y el endpoint del Watch Party, que un paquete puramente estático no
  podría ejecutar.

  ANTES DE EMPAQUETAR: cambia la URL de <content> por la de tu despliegue.
-->
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://canalcasa.local/CanalCasa"
        version="1.0.0"
        viewmodes="maximized">

  <tizen:application id="CanalCasa0.CanalCasa"
                     package="CanalCasa0"
                     required_version="6.0"/>

  <name>CanalCasa</name>
  <description>Canales en vivo, películas y series para tu hogar.</description>

  <!-- Cambia esto por la URL de tu despliegue en Vercel -->
  <content src="https://TU-APP.vercel.app/"/>

  <icon src="icon.png"/>

  <!-- Necesario para cargar la app y los streams desde cualquier origen -->
  <access origin="*" subdomains="true"/>
  <tizen:allow-navigation>*</tizen:allow-navigation>

  <tizen:privilege name="http://tizen.org/privilege/internet"/>

  <tizen:profile name="tv-samsung"/>
  <tizen:setting screen-orientation="landscape"
                 context-menu="disable"
                 background-support="disable"
                 encryption="disable"
                 hwkey-event="enable"/>
</widget>
