{
  "name": "canalcasa",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "next build",
    "start": "next start",
    "analyze": "next experimental-analyze --output",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "addon": "node scripts/probar-addon.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "e2e": "playwright test --trace off"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "hls.js": "^1.7.4",
    "iptv-playlist-parser": "^0.15.2",
    "lucide-react": "^1.70.0",
    "mpegts.js": "^1.8.2",
    "next": "^16.4.5",
    "pusher-js": "^8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@csstools/postcss-cascade-layers": "6.0.2",
    "@playwright/test": "1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.14.0",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=20.9"
  },
  "browserslist": [
    "chrome >= 53",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4"
  ]
}
