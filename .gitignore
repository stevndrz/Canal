# Dependencias
node_modules/

# Build
.next/
build/
dist/
out/

# Entorno
# Todos los .env, no solo tres: Next lee también `.env.production` y
# `.env.development`, que las reglas de antes dejaban fuera.
.env*
!.env.example

# Archivos del sistema
.DS_Store
Thumbs.db
*:Zone.Identifier

# Configuración npm local (rutas específicas de esta máquina)
.npmrc

# Paquetes de diseño / handoff (no son parte de la app)
*.zip
design_handoff_canalcasa_native_shell/

# TypeScript
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Next.js
next-env.d.ts
# Servicio extractor (Python)
__pycache__/
*.py[cod]
.venv/

# Paquetes de televisor (empaque/). Se genera el instalable, no se guarda:
# pesan megas y caducan con el certificado.
empaque/tizen/.buildResult/
empaque/tizen/*.wgt
empaque/android/.gradle/
empaque/android/build/
empaque/android/app/build/
empaque/android/local.properties
empaque/android/gradlew
empaque/android/gradlew.bat
empaque/android/gradle/wrapper/gradle-wrapper.jar
