<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Sin barra de título y con fondo negro desde el primer fotograma.

      El fondo importa más de lo que parece: mientras la WebView carga, lo que
      se ve es el fondo de la ventana. Con el blanco por defecto, arrancar la
      app es un flash blanco a pantalla completa en una habitación a oscuras.
    -->
    <style name="Tema.CanalCasa" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowActionBar">false</item>
    </style>
</resources>
