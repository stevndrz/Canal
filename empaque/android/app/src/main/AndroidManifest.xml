<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Para avisar de «sin conexión» en vez de enseñar la página de error del
         sistema, que en un televisor no dice nada útil. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!--
      Las tres declaraciones que convierten un APK normal en una app de
      televisor. Sin ellas el APK se instala pero NO APARECE en el menú: el
      lanzador de Android TV solo lista lo que declara `leanback`.
    -->
    <uses-feature android:name="android.software.leanback" android:required="true"/>
    <!-- Un televisor no tiene pantalla táctil. Si no se dice, Google Play (y
         algunos lanzadores) dan la app por incompatible. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.hardware.microphone" android:required="false"/>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Tema.CanalCasa"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            android:theme="@style/Tema.CanalCasa"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode|smallestScreenSize|screenLayout">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <!--
                  LEANBACK_LAUNCHER es el de los televisores. Se declara ADEMÁS
                  de LAUNCHER para que el mismo APK se pueda instalar en un
                  teléfono o una tablet y probarlo sin televisor delante.
                -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
