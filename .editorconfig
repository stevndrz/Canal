# Ajustes de editor compartidos, para que el formato no dependa de quién edita.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
# En Markdown dos espacios finales son un salto de línea: no se recortan.
trim_trailing_whitespace = false
